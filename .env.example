# Copie este arquivo para .env na raiz do projeto.
# Neon: cole a connection string do painel Neon em DATABASE_URL.
# Nunca comite o arquivo .env nem compartilhe suas credenciais.
DATABASE_URL=postgresql://USUARIO:SENHA@HOST/BANCO?sslmode=require&channel_binding=require
SECRET_KEY=gere-uma-chave-aleatoria-forte
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173

# Para usar PostgreSQL local via Docker em vez do Neon, use: 
# DATABASE_URL=postgresql://fila:fila123@localhost:5432/filavirtual
